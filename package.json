{
  "name": "syrofolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Syrofolio, an editable vanilla portfolio for what comes next.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "https://github.com/daniasyrofi/syrofolio.git" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dev": "node --watch scripts/dev.mjs",
    "start": "npm run dev",
    "preview": "node scripts/dev.mjs --preview",
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate.mjs && node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": { "@playwright/test": "1.58.2" }
}
